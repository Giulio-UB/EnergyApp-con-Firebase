// --- PDF HELPER ---
const loadJsPDF = async () => {
  if (window.jspdf) return window.jspdf;
  return new Promise((resolve, reject) => {
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
    script.onload = () => resolve(window.jspdf);
    script.onerror = reject;
    document.head.appendChild(script);
  });
};

const generatePDF = async (data, type = 'order') => {
  try {
    const jspdf = await loadJsPDF();
    const { jsPDF } = jspdf;
    const doc = new jsPDF();
    
    // Configurazione Font e Colori
    const primaryColor = [37, 99, 235]; // Blue 600
    const secondaryColor = [71, 85, 105]; // Slate 600
    
    // Header
    doc.setFillColor(...primaryColor);
    doc.rect(0, 0, 210, 20, 'F');
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(16);
    doc.setFont("helvetica", "bold");
    doc.text("SCHEDA TECNICA & COMMERCIALE", 105, 13, { align: "center" });
    
    // Reset testo
    doc.setTextColor(0, 0, 0);
    doc.setFont("helvetica", "normal");
    
    let yPos = 35;

    // Sezione 1: Dati Cliente
    doc.setFontSize(10);
    doc.setTextColor(...secondaryColor);
    doc.text("DATI CLIENTE", 20, yPos);
    doc.line(20, yPos + 2, 190, yPos + 2);
    yPos += 10;

    doc.setFontSize(12);
    doc.setTextColor(0, 0, 0);
    doc.setFont("helvetica", "bold");
    doc.text(data.client || "Cliente Sconosciuto", 20, yPos);
    
    doc.setFontSize(10);
    doc.setFont("helvetica", "normal");
    yPos += 6;
    doc.text(`Indirizzo: ${data.address || "N/D"}`, 20, yPos);
    yPos += 6;
    doc.text(`Referente: ${data.contactName || "-"} | Tel: ${data.phone || "-"}`, 20, yPos);
    yPos += 6;
    doc.text(`Email: ${data.contact || "-"}`, 20, yPos);

    yPos += 15;

    // Sezione 2: Dettagli Impianto / Portafoglio
    doc.setTextColor(...secondaryColor);
    doc.text(type === 'client_sheet' ? "DATI PORTAFOGLIO" : "DETTAGLI IMPIANTO", 20, yPos);
    doc.line(20, yPos + 2, 190, yPos + 2);
    yPos += 10;

    doc.setTextColor(0, 0, 0);
    if (type === 'client_sheet') {
        doc.text(`Numero Pratiche: ${data.totalPratiche}`, 20, yPos);
        yPos += 6;
        doc.text(`Valore Totale Portafoglio: € ${formatCurrency(data.amount)}`, 20, yPos);
        yPos += 6;
    } else {
        doc.text(`Tipologia: ${data.type || "Non specificato"}`, 20, yPos);
        yPos += 6;
        doc.text(`Valore Totale Pratica: € ${formatCurrency(data.amount)}`, 20, yPos);
        yPos += 6;
        doc.text(`Data Contratto: ${data.date ? new Date(data.date).toLocaleDateString('it-IT') : "N/D"}`, 20, yPos);
    }
    
    if (data.notes) {
        yPos += 10;
        doc.setFillColor(248, 250, 252); // Slate 50
        doc.rect(20, yPos - 5, 170, 20, 'F');
        doc.setFontSize(9);
        doc.setTextColor(50, 50, 50);
        doc.text("Note:", 22, yPos);
        const splitNotes = doc.splitTextToSize(data.notes, 160);
        doc.text(splitNotes, 22, yPos + 5);
        yPos += 20;
    } else {
        yPos += 10;
    }

    yPos += 10;

    // Sezione 3: Stato Pagamenti (Solo per singola Pratica)
    if (type === 'order' && data.payments && data.payments.length > 0) {
        if (yPos > 240) { doc.addPage(); yPos = 20; }
        doc.setFontSize(10);
        doc.setTextColor(...secondaryColor);
        doc.text("STATO PAGAMENTI", 20, yPos);
        doc.line(20, yPos + 2, 190, yPos + 2);
        yPos += 10;

        doc.setFontSize(10);
        doc.setTextColor(0, 0, 0);
        
        data.payments.forEach(p => {
            const statusSymbol = p.status === 'Pagato' ? '[X]' : '[ ]';
            const line = `${statusSymbol} ${p.label}: € ${formatCurrency(p.amount)} - Scadenza: ${new Date(p.dueDate).toLocaleDateString('it-IT')}`;
            doc.text(line, 20, yPos);
            yPos += 7;
        });

        yPos += 8;
        if (yPos > 250) { doc.addPage(); yPos = 20; }
        
        doc.setFontSize(10);
        doc.setTextColor(...secondaryColor);
        doc.text("DETTAGLIO PAGAMENTI PROVVIGIONI", 20, yPos);
        doc.line(20, yPos + 2, 190, yPos + 2);
        yPos += 10;

        doc.setFontSize(10);
        doc.setTextColor(0, 0, 0);

        let totalComm = 0;
        data.payments.forEach(p => {
            const comm = calculateCommission(p.amount, data.amount, data.commissionRate);
            totalComm += comm;
            const statusSymbol = p.commissionPaid ? '[X]' : '[ ]';
            const line = `${statusSymbol} Su ${p.label}: € ${formatCurrency(comm)} - Stato Ditta: ${p.commissionPaid ? 'Liquidato' : 'In Attesa'}`;
            doc.text(line, 20, yPos);
            yPos += 7;
        });

        yPos += 3;
        doc.setFont("helvetica", "bold");
        doc.text(`Totale Provvigioni Pratica: € ${formatCurrency(totalComm)}`, 20, yPos);
        doc.setFont("helvetica", "normal");
    }

    // Sezione 4: Provvigioni da Liquidare (Solo per Client_Sheet)
    if (type === 'client_sheet' && data.pendingCommissions && data.pendingCommissions.length > 0) {
        yPos += 10;
        doc.setFontSize(10);
        doc.setTextColor(...secondaryColor);
        doc.text(`PROVVIGIONI DA LIQUIDARE (${data.pendingCommissions.length})`, 20, yPos);
        doc.line(20, yPos + 2, 190, yPos + 2);
        yPos += 10;

        doc.setFontSize(10);
        doc.setTextColor(0, 0, 0);
        
        data.pendingCommissions.forEach(p => {
            const line = `- ${p.orderType || 'Pratica'} | ${p.label}: € ${formatCurrency(p.commissionAmount)} (Incasso: ${new Date(p.dueDate).toLocaleDateString('it-IT')})`;
            doc.text(line, 20, yPos);
            yPos += 7;
        });

        yPos += 3;
        doc.setFont("helvetica", "bold");
        doc.text(`Totale da Liquidare: € ${formatCurrency(data.totalPendingCommissionAmount)}`, 20, yPos);
        doc.setFont("helvetica", "normal");
    }

    // Sezione 5: Report Distinta Provvigioni (Solo per commission_report)
    if (type === 'commission_report' && data.items) {
        doc.setTextColor(...secondaryColor);
        doc.text("DISTINTA PROVVIGIONI MATURATE DA LIQUIDARE", 20, yPos);
        doc.line(20, yPos + 2, 190, yPos + 2);
        yPos += 10;

        doc.setTextColor(0, 0, 0);
        data.items.forEach(p => {
            if (yPos > 270) { doc.addPage(); yPos = 20; }
            doc.setFontSize(10);
            doc.setFont("helvetica", "bold");
            doc.text(`Cliente: ${p.client}`, 20, yPos);
            yPos += 5;
            doc.setFont("helvetica", "normal");
            doc.text(`Rif: ${p.paymentLabel} | Incasso ditta: € ${formatCurrency(p.amount)} | In data: ${new Date(p.dueDate).toLocaleDateString('it-IT')}`, 20, yPos);
            yPos += 5;
            doc.setFont("helvetica", "bold");
            doc.setTextColor(...primaryColor);
            doc.text(`Provvigione: € ${formatCurrency(p.commissionAmount)}`, 20, yPos);
            doc.setTextColor(0, 0, 0);
            yPos += 8;
        });

        yPos += 5;
        doc.line(20, yPos, 190, yPos);
        yPos += 10;
        doc.setFontSize(14);
        doc.setFont("helvetica", "bold");
        doc.text(`TOTALE RICHIESTO: € ${formatCurrency(data.total)}`, 20, yPos);
    }

    // Footer
    doc.setFontSize(8);
    doc.setTextColor(150, 150, 150);
    doc.text(`Documento generato il ${new Date().toLocaleDateString('it-IT')} da EnergyApp`, 105, 280, { align: "center" });

    return doc;
  } catch (error) {
    console.error("Errore generazione PDF:", error);
    return null;
  }
};

// --- GEMINI API HELPER ---
const callGemini = async (prompt, systemInstruction) => {
  const apiKey = ""; // Runtime environment provides this
  try {
    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ text: prompt }] }],
        systemInstruction: { parts: [{ text: systemInstruction }] },
        generationConfig: { responseMimeType: "application/json" }
      })
    });
    
    if (!response.ok) throw new Error('API Error');
    const data = await response.json();
    return JSON.parse(data.candidates[0].content.parts[0].text);
  } catch (error) {
    console.error("Gemini Error:", error);
    return null;
  }
};

