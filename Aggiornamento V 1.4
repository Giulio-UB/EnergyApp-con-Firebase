                >
                    <PlusCircle size={18}/> Nuova Nota
                </button>
            </div>

            {notes.length === 0 ? (
                <div className="p-12 text-center bg-white rounded-xl border border-dashed border-slate-300">
                    <Pin size={48} className="mx-auto text-slate-300 mb-4 fill-slate-100" />
