                <button 
                    onClick={() => setIsNotificationsOpen(!isNotificationsOpen)} 
                    className={`relative p-2.5 rounded-full transition-colors ${isNotificationsOpen ? 'bg-slate-100 text-slate-800' : 'text-slate-400 hover:bg-slate-100 hover:text-slate-800'}`}
                    title="Notifiche"
                >
                    <Bell size={22} />
                    {currentNotifications.length > 0 && (
                        <span className="absolute top-1 right-1 flex h-4 w-4 items-center justify-center rounded-full bg-red-600 text-[9px] text-white font-bold ring-2 ring-white shadow-sm">
                            {currentNotifications.length}
                        </span>
                    )}
                </button>

                {/* Dropdown Notifiche */}
                {isNotificationsOpen && (
                    <div className="absolute right-0 mt-3 w-80 bg-white rounded-xl shadow-2xl border border-slate-200 overflow-hidden animate-fade-in-down origin-top-right">
                        <div className="bg-slate-50 p-3 border-b border-slate-200 flex justify-between items-center">
                            <h3 className="font-bold text-slate-800 text-sm">Action Items</h3>
                            <span className="bg-red-100 text-red-800 text-[10px] px-2 py-0.5 rounded-full font-bold">
                                {currentNotifications.length} Pendenti
                            </span>
                        </div>
                        <div className="max-h-80 overflow-y-auto">
                            {currentNotifications.length === 0 ? (
                                <div className="p-6 text-center">
                                    <CheckCircle size={32} className="mx-auto text-emerald-300 mb-2" />
                                    <p className="text-slate-500 text-sm font-medium">Tutto sotto controllo!</p>
                                    <p className="text-xs text-slate-400">Nessuna notifica in sospeso.</p>
                                </div>
                            ) : (
                                currentNotifications.map(n => (
                                    <div 
                                        key={n.id} 
                                        onClick={n.action} 
                                        className="p-3 border-b border-slate-50 hover:bg-blue-50 cursor-pointer transition-colors flex items-start gap-3 group"
                                    >
                                        <div className="mt-0.5 p-1.5 bg-white rounded-full border border-slate-100 shadow-sm shrink-0 group-hover:scale-110 transition-transform">
                                            {n.icon}
                                        </div>
                                        <div>
                                            <p className="text-xs font-bold text-slate-800 group-hover:text-blue-700 transition-colors">{n.title}</p>
                                            <p className="text-[11px] text-slate-600 line-clamp-2 leading-tight mt-0.5">{n.message}</p>
                                            <p className="text-[10px] text-slate-400 mt-1.5 flex items-center gap-1 font-mono">
                                                <Clock size={10} /> {new Date(n.date).toLocaleDateString('it-IT')}
                                            </p>
                                        </div>
                                    </div>
                                ))
                            )}
                        </div>
                    </div>
                )}
             </div>
          </div>
        </header>
        <div className="flex-1 overflow-y-auto p-8 bg-slate-50 print:p-0 print:bg-white" onClick={() => isNotificationsOpen && setIsNotificationsOpen(false)}>
          <div className="print:hidden">
            {activeTab === 'dashboard' && <DashboardView orders={orders} setActiveTab={setActiveTab} opportunities={opportunities} calendarEvents={calendarEvents} notes={notes} handleAddNote={handleAddNote} links={links} onUpdateLinks={onUpdateLinks} />}
            {activeTab === 'new' && <NewOrderView newOrder={newOrder} setNewOrder={setNewOrder} handleAddOrder={handleAddOrder} setActiveTab={setActiveTab} />}
            {activeTab === 'orders' && <OrdersListView orders={orders} getCompanyPaymentDate={getCompanyPaymentDate} handleDeleteOrder={handleDeleteOrder} handleUpdatePaymentStatus={handleUpdatePaymentStatus} handleDraftEmail={handleDraftEmail} handleUpdateOrder={handleUpdateOrder} />}
            {activeTab === 'clients' && <ClientsView orders={orders} />}
            {activeTab === 'commissions' && <CommissionsView orders={orders} getCompanyPaymentDate={getCompanyPaymentDate} handleUpdateCommissionPaid={handleUpdateCommissionPaid} />}
            {activeTab === 'opportunities' && <OpportunitiesView opportunities={opportunities} handleAddOpportunity={handleAddOpportunity} handleToggleCompleteOpportunity={handleToggleCompleteOpportunity} handleDeleteOpportunity={handleDeleteOpportunity} handleGenerateSuggestions={handleGenerateSuggestions} />}
            {activeTab === 'calendar' && <CalendarView orders={orders} opportunities={opportunities} calendarEvents={calendarEvents} handleAddCalendarEvent={handleAddCalendarEvent} handleUpdateCalendarEvent={handleUpdateCalendarEvent} handleDeleteCalendarEvent={handleDeleteCalendarEvent} />}
            {activeTab === 'carCost' && <CarCostView carConfig={carConfig} updateCarConfig={updateCarConfig} travels={travels} handleAddTravel={handleAddTravel} handleDeleteTravel={handleDeleteTravel} clients={clientList} />} 
            {activeTab === 'notes' && <NotesView notes={notes} handleAddNote={handleAddNote} handleDeleteNote={handleDeleteNote} handleUpdateNote={handleUpdateNote} />}
          </div>
        </div>
        {(saveStatus === 'saved' || saveStatus === 'loaded' || saveStatus === 'deleted') && (
            <div className={`absolute bottom-6 left-8 bg-slate-800 text-white px-4 py-2 rounded-lg shadow-xl flex items-center gap-2 text-sm font-medium animate-fade-in-up z-50 print:hidden`}>
                <Database size={16} className={saveStatus === 'loaded' ? 'text-blue-400' : saveStatus === 'deleted' ? 'text-red-400' : 'text-emerald-400'} />
                {saveStatus === 'saved' && 'Cloud Aggiornato.'}
                {saveStatus === 'loaded' && 'Dati Sincronizzati.'}
                {saveStatus === 'deleted' && 'Eliminato.'}
            </div>
        )}
      </main>
    </div>
  );
}
