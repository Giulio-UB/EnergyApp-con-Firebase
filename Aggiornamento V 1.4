// --- MODAL EDIT UTILITY LINKS ---
const EditLinksModal = ({ isOpen, onClose, links, onSave }) => {
    const [localLinks, setLocalLinks] = useState([]);

    useEffect(() => {
        if (links) setLocalLinks(links);
    }, [links, isOpen]);

    if (!isOpen) return null;

    const handleUpdate = (index, field, value) => {
        const updated = [...localLinks];
        updated[index] = { ...updated[index], [field]: value };
        setLocalLinks(updated);
    };

    const handleAdd = () => {
        setLocalLinks([...localLinks, { name: '', url: '' }]);
    };

    const handleRemove = (index) => {
        setLocalLinks(localLinks.filter((_, i) => i !== index));
    };

    const handleSubmit = (e) => {
        e.preventDefault();
        onSave(localLinks.filter(l => l.name.trim() && l.url.trim()));
        onClose();
    };

    return (
        <div className="fixed inset-0 bg-black/50 z-[80] flex items-center justify-center p-4 animate-fade-in">
            <div className="bg-white rounded-xl shadow-2xl w-full max-w-xl overflow-hidden flex flex-col max-h-[85vh]">
                <div className="bg-[#0e5c2f] p-4 flex justify-between items-center text-white">
                    <h3 className="font-bold flex items-center gap-2"><Settings size={18} /> Gestione Tool & Utility</h3>
                    <button onClick={onClose} className="hover:bg-white/20 p-1 rounded-full"><X size={20}/></button>
                </div>
                <div className="p-6 overflow-y-auto space-y-4 flex-1">
                    <p className="text-xs text-slate-500 font-medium">Aggiungi o modifica i link rapidi mostrati nella Dashboard.</p>
                    {localLinks.map((link, idx) => (
                        <div key={idx} className="flex gap-3 items-end bg-slate-50 p-3 rounded-lg border border-slate-200">
                            <div className="flex-1 space-y-2">
                                <input 
                                    placeholder="Nome Tool" 
                                    value={link.name} 
                                    onChange={(e) => handleUpdate(idx, 'name', e.target.value)} 
                                    className="w-full text-sm p-2 border rounded border-slate-300 focus:ring-1 focus:ring-[#0e5c2f] outline-none"
                                />
                                <input 
                                    placeholder="https://..." 
                                    value={link.url} 
                                    onChange={(e) => handleUpdate(idx, 'url', e.target.value)} 
                                    className="w-full text-xs p-2 border rounded border-slate-300 focus:ring-1 focus:ring-[#0e5c2f] outline-none font-mono"
                                />
                            </div>
                            <button onClick={() => handleRemove(idx)} className="p-2 text-red-500 hover:bg-red-50 rounded"><Trash2 size={18}/></button>
                        </div>
                    ))}
                    <button 
                        onClick={handleAdd}
                        className="w-full py-2 border-2 border-dashed border-slate-300 rounded-lg text-slate-500 hover:bg-slate-50 hover:border-slate-400 transition-all flex items-center justify-center gap-2 font-medium"
                    >
                        <PlusCircle size={16}/> Aggiungi Link
                    </button>
                </div>
                <div className="p-4 border-t bg-slate-50 flex justify-end gap-2">
                    <button onClick={onClose} className="px-4 py-2 text-slate-600 font-medium">Annulla</button>
                    <button onClick={handleSubmit} className="px-6 py-2 bg-[#0e5c2f] text-white rounded-lg font-bold shadow-md">Salva Link</button>
                </div>
            </div>
        </div>
    );
};


// --- VISTE ---

const CalendarView = ({ orders, opportunities, calendarEvents, handleAddCalendarEvent, handleUpdateCalendarEvent, handleDeleteCalendarEvent }) => {
  const [currentDate, setCurrentDate] = useState(new Date());
  const [viewMode, setViewMode] = useState('month'); 
  const [editingEvent, setEditingEvent] = useState(null); 

  const getDaysInMonth = (year, month) => new Date(year, month + 1, 0).getDate();
  const getFirstDayOfMonth = (year, month) => {
    let day = new Date(year, month, 1).getDay();
    return day === 0 ? 6 : day - 1; 
  };

  const year = currentDate.getFullYear();
  const month = currentDate.getMonth();
  const daysInMonth = getDaysInMonth(year, month);
  const firstDay = getFirstDayOfMonth(year, month);

  const events = [];
  
  (orders || []).forEach(order => {
    (order.payments || []).forEach(payment => {
        if(payment.dueDate) {
            const d = new Date(payment.dueDate);
            if (!isNaN(d.getTime())) {
                events.push({
                    date: d, type: 'payment', title: `${order.client} - ${payment.label}`, amount: payment.amount, status: payment.status, id: `${order.id}-${payment.id}`
                });
            }
        }
    });
  });

  (opportunities || []).forEach(opp => {
      if(opp.date) {
          const d = new Date(opp.date);
          if (!isNaN(d.getTime())) {
            events.push({ date: d, type: 'opportunity', title: opp.text, time: opp.time, completed: opp.completed, id: opp.id });
          }
      }
  });

  (calendarEvents || []).forEach(evt => {
       if (evt.date) {
           const d = new Date(evt.date);
           if (!isNaN(d.getTime())) {
               events.push({ date: d, type: 'generic_event', title: evt.title, time: evt.time, description: evt.description, id: evt.id, originalData: evt })
           }
       }
  });

  const getEventsForDay = (date) => events.filter(e => e.date.getDate() === date.getDate() && e.date.getMonth() === date.getMonth() && e.date.getFullYear() === date.getFullYear());
  const monthNames = ["Gennaio", "Febbraio", "Marzo", "Aprile", "Maggio", "Giugno", "Luglio", "Agosto", "Settembre", "Ottobre", "Novembre", "Dicembre"];
  const dayNames = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'];

  const navigateDate = (direction) => {
      const newDate = new Date(currentDate);
      if (viewMode === 'month') { newDate.setMonth(newDate.getMonth() + direction); } 
      else { newDate.setDate(newDate.getDate() + (direction * 3)); }
      setCurrentDate(newDate);
  };
  const goToToday = () => setCurrentDate(new Date());
  const handleOpenAddModal = () => setEditingEvent({}); 
  const handleSaveEvent = (data) => { if (data.id) { handleUpdateCalendarEvent(data); } else { handleAddCalendarEvent(data); } }

  const renderMonthView = () => (
      <div className="grid grid-cols-7 gap-px bg-slate-200 rounded-lg overflow-hidden border border-slate-200">
          {['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'].map(d => (<div key={d} className="bg-slate-50 p-2 text-center text-xs font-bold text-slate-500 uppercase">{d}</div>))}
          {[...Array(Math.max(0, firstDay))].map((_, i) => (<div key={`empty-${i}`} className="bg-white h-32 p-2"></div>))}
          {[...Array(Math.max(0, daysInMonth))].map((_, i) => {
              const day = i + 1; const date = new Date(year, month, day); const daysEvents = getEventsForDay(date); const isToday = new Date().toDateString() === date.toDateString();
              return (
                  <div key={day} className={`bg-white h-32 p-2 border-t border-l border-slate-100 hover:bg-slate-50 transition-colors relative group ${isToday ? 'bg-green-50/30' : ''}`}>
                      <span className={`text-sm font-semibold ${isToday ? 'bg-[#0e5c2f] text-white w-6 h-6 flex items-center justify-center rounded-full' : 'text-slate-700'}`}>{day}</span>
                      <div className="mt-1 space-y-1 overflow-y-auto max-h-[90px] no-scrollbar">
                          {daysEvents.map((evt, idx) => (
                              <div key={idx} onClick={() => evt.type === 'generic_event' ? setEditingEvent(evt.originalData) : null} className={`text-[10px] p-1 rounded border truncate cursor-pointer shadow-sm ${evt.type === 'payment' ? (evt.status === 'Pagato' ? 'bg-emerald-100 border-emerald-200 text-emerald-800' : 'bg-amber-100 border-amber-200 text-amber-800') : evt.type === 'generic_event' ? 'bg-purple-100 border-purple-200 text-purple-800 hover:bg-purple-200' : 'bg-blue-100 border-blue-200 text-blue-800'}`} title={evt.title}>
                                  {evt.type === 'payment' ? '€' : evt.type === 'generic_event' ? '📅' : '•'} {evt.title}
                              </div>
                          ))}
                      </div>
                  </div>
              );
          })}
      </div>
  );

  const renderThreeDayView = () => {
      const days = []; for(let i=0; i<3; i++) { const d = new Date(currentDate); d.setDate(d.getDate() + i); days.push(d); }
      const hours = Array.from({length: 13}, (_, i) => i + 8); // 08:00 to 20:00

      return (
          <div className="flex flex-col h-[600px] overflow-hidden bg-white rounded-lg border border-slate-200">
              <div className="flex border-b border-slate-200">
                  <div className="w-16 border-r border-slate-200 bg-slate-50 flex items-center justify-center text-xs text-slate-400">Tutto il gg</div>
                  {days.map((day, i) => (
                      <div key={i} className="flex-1 p-2 text-center border-r border-slate-200 bg-slate-50 last:border-r-0">
                          <div className="text-xs text-slate-500 uppercase font-bold">{dayNames[day.getDay()]}</div>
                          <div className={`text-lg font-bold ${new Date().toDateString() === day.toDateString() ? 'text-[#0e5c2f]' : 'text-slate-800'}`}>{day.getDate()} {monthNames[day.getMonth()]?.substring(0,3)}</div>
                      </div>
                  ))}
              </div>
               <div className="flex border-b border-slate-200 min-h-[50px]">
                   <div className="w-16 border-r border-slate-200 bg-slate-50"></div>
                   {days.map((day, i) => {
                        const dayEvents = getEventsForDay(day); const allDayEvents = dayEvents.filter(e => !e.time);
                        return (
                            <div key={`allday-${i}`} className="flex-1 border-r border-slate-100 p-1 last:border-r-0">
                                {allDayEvents.map((evt, idx) => (
                                    <div key={idx} onClick={() => evt.type === 'generic_event' ? setEditingEvent(evt.originalData) : null} className={`text-[10px] p-1 mb-1 rounded border cursor-pointer shadow-sm truncate ${evt.type === 'generic_event' ? 'bg-purple-100 border-purple-200 text-purple-800 hover:bg-purple-200' : 'bg-blue-100 border-blue-200 text-blue-800'}`} title={evt.title}>{evt.title}</div>
                                ))}
                            </div>
                        )
                   })}
               </div>
              <div className="flex-1 overflow-y-auto">
                  {hours.map(hour => (
                      <div key={hour} className="flex min-h-[60px] border-b border-slate-100">
                          <div className="w-16 border-r border-slate-200 p-2 text-xs text-slate-400 text-right sticky left-0 bg-white">{hour}:00</div>
                          {days.map((day, i) => {
                              // Controllo di tipo rigoroso sull'orario per evitare crash
                              const dayEvents = getEventsForDay(day); 
                              const hourEvents = dayEvents.filter(e => { 
                                  if (!e.time || typeof e.time !== 'string') return false; 
                                  return parseInt(e.time.split(':')[0]) === hour; 
                              });
                              return (
                                  <div key={i} className="flex-1 border-r border-slate-100 p-1 relative last:border-r-0">
                                      {hourEvents.map((evt, idx) => (
                                          <div key={idx} onClick={() => evt.type === 'generic_event' ? setEditingEvent(evt.originalData) : null} className={`text-[10px] p-1 mb-1 rounded border cursor-pointer shadow-sm ${evt.type === 'generic_event' ? 'bg-purple-100 border-purple-200 text-purple-800 hover:bg-purple-200' : 'bg-blue-100 border-blue-200 text-blue-800'}`}>
                                              <span className="font-bold">{evt.time}</span> {evt.title}
                                          </div>
                                      ))}
                                  </div>
                              );
                          })}
                      </div>
                  ))}
              </div>
          </div>
      );
  };

  return (
    <div className="space-y-6 animate-fade-in">
        <EditEventModal isOpen={!!editingEvent} onClose={() => setEditingEvent(null)} event={editingEvent} onSave={handleSaveEvent} onDelete={handleDeleteCalendarEvent}/>
        <div className="flex justify-between items-center">
             <h2 className="text-2xl font-bold text-slate-800 flex items-center gap-2"><Calendar className="text-[#0e5c2f]"/> Calendario Scadenze</h2>
             <div className="flex items-center gap-4">
                 <div className="flex bg-slate-100 p-1 rounded-lg">
                     <button onClick={() => setViewMode('month')} className={`px-3 py-1 text-sm font-medium rounded-md transition-all ${viewMode === 'month' ? 'bg-white text-[#0e5c2f] shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>Mese</button>
                     <button onClick={() => setViewMode('3day')} className={`px-3 py-1 text-sm font-medium rounded-md transition-all ${viewMode === '3day' ? 'bg-white text-[#0e5c2f] shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>3 Giorni</button>
                 </div>
                 <button onClick={handleOpenAddModal} className="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-sm font-medium transition-colors flex items-center gap-2 shadow-sm"><CalendarPlus size={16}/> Nuovo Evento</button>
                 <button onClick={goToToday} className="px-3 py-1 bg-white text-slate-600 border border-slate-300 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors">Oggi</button>
                 <div className="flex items-center gap-2 bg-white p-2 rounded-lg shadow-sm border border-slate-200">
                    <button onClick={() => navigateDate(-1)} className="p-1 hover:bg-slate-100 rounded-full"><ChevronRight className="rotate-180" size={20}/></button>
                    <span className="font-bold text-lg w-32 text-center text-slate-800">{viewMode === 'month' ? `${monthNames[month]} ${year}` : 'Naviga'}</span>
                    <button onClick={() => navigateDate(1)} className="p-1 hover:bg-slate-100 rounded-full"><ChevronRight size={20}/></button>
                 </div>
             </div>
        </div>
        {viewMode === 'month' ? renderMonthView() : renderThreeDayView()}
        {viewMode === 'month' && (
            <div className="mt-6">
                <h3 className="text-lg font-semibold text-slate-800 mb-4">Agenda del Mese ({monthNames[month]})</h3>
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                     {events.filter(e => e.date.getMonth() === month && e.date.getFullYear() === year).sort((a,b) => a.date - b.date).map((evt, idx) => (
                        <Card key={idx} className="p-4 flex items-start gap-3">
                            <div className={`mt-1 w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0 ${evt.type === 'payment' ? 'bg-amber-500' : evt.type === 'generic_event' ? 'bg-purple-500' : 'bg-[#0e5c2f]'}`}>{evt.date.getDate()}</div>
                            <div className="overflow-hidden flex-1">
                                <div className="flex justify-between items-start">
                                    <p className="font-bold text-slate-800 truncate">{evt.title}</p>
                                    {evt.type === 'generic_event' && <button onClick={() => setEditingEvent(evt.originalData)} className="text-purple-400 hover:text-purple-600"><Pencil size={12}/></button>}
                                </div>
                                <p className="text-xs text-slate-500 mt-1">{evt.type === 'payment' ? `Rata: € ${formatCurrency(evt.amount)} - ${evt.status}` : (evt.description || `Nota ${evt.time ? 'ore ' + evt.time : ''}`)}</p>
                            </div>
                        </Card>
                     ))}
                     {events.filter(e => e.date.getMonth() === month && e.date.getFullYear() === year).length === 0 && (<p className="text-slate-400 italic col-span-3 text-center py-4">Nessun evento in programma per questo mese.</p>)}
                </div>
            </div>
        )}
    </div>
  );
};

