        <div className="space-y-6 animate-fade-in max-w-6xl mx-auto">
            <NoteModal 
                isOpen={!!editingNote} 
                onClose={() => setEditingNote(null)} 
                note={editingNote} 
                onSave={(noteData) => {
                    if (noteData.id) handleUpdateNote(noteData);
                    else handleAddNote({...noteData, createdAt: new Date().toISOString()});
                }} 
            />
            
            <div className="flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <div className="flex items-center gap-3">
                    <div className="p-2 bg-yellow-100 rounded-lg text-yellow-700"><StickyNote size={24} /></div>
