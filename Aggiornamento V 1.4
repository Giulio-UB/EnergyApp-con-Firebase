          <button type="button" onClick={() => setActiveTab('dashboard')} className="px-6 py-2 text-slate-600 hover:bg-slate-100 rounded-lg font-medium transition-colors">Annulla</button>
          <button type="submit" className="px-6 py-2 bg-[#0e5c2f] text-white rounded-lg font-medium hover:bg-[#166534] shadow-md transition-colors flex items-center gap-2"><CheckCircle size={18} /> Salva Pratica</button>
        </div>
      </form>
    </Card>
  </div>
);

