                        <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Link Sito Web</label>
                        <input name="webLink" value={formData.webLink || ''} onChange={handleChange} className="w-full border p-2 rounded" />
                    </div>
                    <div className="md:col-span-2">
                        <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Note</label>
                        <textarea name="notes" value={formData.notes || ''} onChange={handleChange} className="w-full border p-2 rounded h-20 resize-none" />
                    </div>

                    <div className="md:col-span-2 flex justify-end gap-2 pt-4 border-t mt-2 sticky bottom-0 bg-white pb-2">
                        <button type="button" onClick={onClose} className="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded font-medium">Annulla</button>
                        <button type="submit" className="px-4 py-2 bg-[#0e5c2f] text-white rounded hover:bg-[#166534] font-medium">Salva Modifiche</button>
                    </div>
                </form>
            </div>
        </div>
    );
};

const EditEventModal = ({ isOpen, onClose, event, onSave, onDelete }) => {
    const [formData, setFormData] = useState({ title: '', date: '', time: '', description: '', type: 'generic_event' });

    useEffect(() => {
        let safeDate = '';
        if (event && event.date) {
            try {
                // Parsing sicuro e tollerante ai fusi orari
                if (typeof event.date === 'string' && event.date.includes('-')) {
                    safeDate = event.date.split('T')[0];
                } else {
                    const d = new Date(event.date);
                    if (!isNaN(d.getTime())) safeDate = d.toISOString().split('T')[0];
                }
            } catch (e) {
                console.warn("Formato data evento anomalo, fallback sicuro applicato.");
            }
        }

        if (event && Object.keys(event).length > 0) {
             setFormData({
                id: event.id || null,
                title: event.title || '',
                date: safeDate,
                time: event.time || '',
                description: event.description || '',
                type: 'generic_event'
            });
        } else {
            setFormData({ title: '', date: new Date().toISOString().split('T')[0], time: '', description: '', type: 'generic_event' });
        }
    }, [event, isOpen]);

    if (!isOpen) return null;

    const handleChange = (e) => setFormData({ ...formData, [e.target.name]: e.target.value });
    const handleSubmit = (e) => { e.preventDefault(); onSave(formData); onClose(); };

    return (
        <div className="fixed inset-0 bg-black/50 z-[70] flex items-center justify-center p-4 animate-fade-in">
            <div className="bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden">
                <div className="bg-[#0e5c2f] p-4 flex justify-between items-center text-white">
                    <h3 className="font-bold flex items-center gap-2"><CalendarPlus size={18} /> {event?.id ? 'Modifica Evento' : 'Nuovo Evento'}</h3>
                    <button onClick={onClose} className="hover:bg-white/20 p-1 rounded-full"><X size={20}/></button>
                </div>
                <form onSubmit={handleSubmit} className="p-6 space-y-4">
                    <div>
                        <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Titolo</label>
                        <input name="title" value={formData.title} onChange={handleChange} className="w-full border p-2 rounded focus:ring-2 focus:ring-[#0e5c2f] outline-none" required placeholder="Es. Sopralluogo" />
                    </div>
                    <div className="grid grid-cols-2 gap-4">
                        <div>
                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Data</label>
                            <input type="date" name="date" value={formData.date} onChange={handleChange} className="w-full border p-2 rounded focus:ring-2 focus:ring-[#0e5c2f] outline-none" required />
                        </div>
                        <div>
                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Ora (Opzionale)</label>
                            <input type="time" name="time" value={formData.time} onChange={handleChange} className="w-full border p-2 rounded focus:ring-2 focus:ring-[#0e5c2f] outline-none" />
                        </div>
                    </div>
                    <div>
                        <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Descrizione</label>
                        <textarea name="description" value={formData.description} onChange={handleChange} className="w-full border p-2 rounded focus:ring-2 focus:ring-[#0e5c2f] outline-none h-24 resize-none" placeholder="Dettagli aggiuntivi..." />
                    </div>
                    <div className="flex justify-between pt-2 border-t mt-2">
                        {event?.id && onDelete ? (
                             <button type="button" onClick={() => { onDelete(event.id); onClose(); }} className="px-3 py-2 text-red-600 hover:bg-red-50 rounded flex items-center gap-1 font-medium"><Trash2 size={16}/> Elimina</button>
                        ) : <div></div>}
                        <div className="flex gap-2">
                            <button type="button" onClick={onClose} className="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded font-medium">Annulla</button>
                            <button type="submit" className="px-4 py-2 bg-[#0e5c2f] text-white rounded hover:bg-[#166534] font-medium">Salva</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    );
};

