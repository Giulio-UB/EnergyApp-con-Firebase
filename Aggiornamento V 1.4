const ClientsView = ({ orders }) => {
    const [generatingPdf, setGeneratingPdf] = useState(null);

    const onGeneratePdf = async (client, mode = 'download') => {
        const mockOrderData = {
            client: client.name,
            address: client.address,
            contactName: client.contactName,
            contact: client.contact,
            phone: client.phone,
            type: "Portafoglio Cliente",
            amount: client.totalAmount,
            totalPratiche: client.totalPratiche,
            date: new Date().toISOString(),
            notes: `Cliente con ${client.totalPratiche} pratiche attive. Storico: ${client.pratiche.map(p => p.type).join(', ')}.`,
            pendingCommissions: client.pendingCommissions,
            totalPendingCommissionAmount: client.totalPendingCommissionAmount
        };

        setGeneratingPdf(client.name);
        const doc = await generatePDF(mockOrderData, 'client_sheet');
        
        if (doc) {
          const fileName = `Scheda_Cliente_${client.name.replace(/\s+/g, '_')}.pdf`;
          if (mode === 'share') {
               doc.save(fileName); 

               const textLines = [
                   `*SCHEDA CLIENTE: ${client.name.toUpperCase()}* 📂`,
                   ``,
                   `📍 *Indirizzo:* ${client.address || 'N/D'}`,
                   `📞 *Tel:* ${client.phone || 'N/D'}`,
                   ``,
                   `*DATI PORTAFOGLIO*`,
                   `*Pratiche:* ${client.totalPratiche}`,
                   `*Fatturato:* € ${formatCurrency(client.totalAmount)}`,
               ];

               // Aggiunta dinamica Dettaglio Pagamenti Provvigioni
               if (client.pendingCommissions && client.pendingCommissions.length > 0) {
                    textLines.push(``);
                    textLines.push(`⏱️ *PROVVIGIONI DA LIQUIDARE (${client.pendingCommissions.length})*`);
                    textLines.push(`*Totale:* € ${formatCurrency(client.totalPendingCommissionAmount)}`);
                    client.pendingCommissions.forEach(pc => {
                        textLines.push(`- ${pc.label}: € ${formatCurrency(pc.commissionAmount)}`);
                    });
               }

               textLines.push(``);
               textLines.push(`_Trovi la scheda completa in allegato scaricato sul PC._`);

               const waText = encodeURIComponent(textLines.join('\n'));
               window.open(`https://api.whatsapp.com/send?text=${waText}`, '_blank');
          } else {
              doc.save(fileName);
          }
        }
        setGeneratingPdf(null);
    }

    const uniqueClientsMap = orders.reduce((acc, order) => {
        const clientKey = order.client; 
        if (!acc[clientKey]) {
            acc[clientKey] = { name: order.client, address: order.address, contactName: order.contactName || '', contact: order.contact || 'N/D', phone: order.phone || 'N/D', totalPratiche: 0, totalAmount: 0, pratiche: [], pendingCommissions: [], totalPendingCommissionAmount: 0 };
        }
        acc[clientKey].totalPratiche += 1;
        acc[clientKey].totalAmount += (parseFloat(order.amount) || 0);
        acc[clientKey].pratiche.push({ 
            id: order.id, type: order.type, status: order.status, date: order.date, notes: order.notes, docsLink: order.docsLink, webLink: order.webLink
        });
        
        // Calcolo Provvigioni da Liquidare per questo cliente
        let pendingCommissions = [];
        (order.payments || []).forEach(p => {
            if (p.status === 'Pagato' && !p.commissionPaid) {
                const comm = calculateCommission(p.amount, order.amount, order.commissionRate);
                pendingCommissions.push({ ...p, orderType: order.type, commissionAmount: comm });
            }
        });
        acc[clientKey].pendingCommissions = [...acc[clientKey].pendingCommissions, ...pendingCommissions];
        acc[clientKey].totalPendingCommissionAmount += pendingCommissions.reduce((sum, p) => sum + p.commissionAmount, 0);

        return acc;
    }, {});
    
    const clients = Object.values(uniqueClientsMap);

    return (
        <div className="space-y-6 animate-fade-in">
            <div className="flex justify-between items-center"><h2 className="text-2xl font-bold text-slate-800">Archivio Clienti ({formatNumber(clients.length)})</h2><input type="text" placeholder="Cerca cliente per nome..." className="px-4 py-2 border rounded-lg text-sm w-64 focus:ring-2 focus:ring-[#0e5c2f] focus:outline-none" /></div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {clients.map((client, index) => (
                    <Card key={index} className="p-6 hover:shadow-xl transition-all duration-200">
                        <div className="flex justify-between items-start mb-1">
                            <h3 className="text-2xl font-bold text-[#0e5c2f]">{client.name}</h3>
                            <div className="text-sm font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">{client.totalPratiche} Pratic{client.totalPratiche > 1 ? 'he' : 'a'}</div>
                        </div>
                        {client.contactName && <p className="text-sm font-medium text-slate-500 mb-4">Referente: {client.contactName}</p>}

                        <div className="space-y-2 text-sm text-slate-600 mb-4">
                            {client.address && <p className="flex items-center gap-2"><MapPin size={16} className="text-slate-400"/> {client.address}</p>}
                            {client.contact && <p className="flex items-center gap-2"><Mail size={16} className="text-slate-400"/> {client.contact}</p>}
                            {client.phone && <p className="flex items-center gap-2"><Phone size={16} className="text-slate-400"/> {client.phone}</p>}
                        </div>
                        
                        <p className="text-lg font-bold text-slate-800 mb-5">Fatturato Cliente: € {formatCurrency(client.totalAmount)}</p>

                        <div className="flex gap-3 mb-6">
                             <button onClick={() => onGeneratePdf(client, 'download')} disabled={generatingPdf === client.name} className="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-slate-100 text-slate-700 rounded-lg border border-slate-200 text-sm font-bold hover:bg-slate-200 transition-colors">
                                {generatingPdf === client.name ? <Loader className="animate-spin" size={16}/> : <Download size={16} />} PDF
                            </button>
                             <button onClick={() => onGeneratePdf(client, 'share')} disabled={generatingPdf === client.name} className="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-[#dcfce7] text-[#166534] rounded-lg border border-[#bbf7d0] text-sm font-bold hover:bg-[#bbf7d0] transition-colors">
                                {generatingPdf === client.name ? <Loader className="animate-spin" size={16}/> : <Share2 size={16} />} WhatsApp
                            </button>
                        </div>

                        <div className="pt-4 border-t border-slate-100">
                            <p className="text-xs font-bold text-slate-500 mb-3 uppercase tracking-wider">Storico Pratiche:</p>
                            <ul className="space-y-3">
                                {(client.pratiche || []).map(p => (
                                    <li key={p.id} className="flex justify-between items-start">
                                        <div className="flex flex-col flex-1">
                                            <span className="font-semibold text-slate-800 text-sm">{p.type}</span>
                                            <span className="text-[11px] text-slate-500 italic mt-0.5">Contratto: {new Date(p.date).toLocaleDateString('it-IT')}</span>
                                            <div className="flex gap-2 mt-1.5">
                                                {p.docsLink && <a href={p.docsLink} target="_blank" rel="noopener noreferrer" title="Drive"><FolderOpen size={12} className="text-blue-500 hover:text-blue-700"/></a>}
                                                {p.webLink && <a href={p.webLink} target="_blank" rel="noopener noreferrer" title="Sito"><Globe size={12} className="text-slate-500 hover:text-slate-700"/></a>}
                                            </div>
                                        </div>
                                        <Badge status={p.status} />
                                    </li>
                                ))}
                            </ul>
                            
                            {client.pendingCommissions && client.pendingCommissions.length > 0 && (
                                <div className="mt-4 p-3 bg-amber-50 rounded-lg border border-amber-200">
                                    <p className="text-xs font-bold text-amber-800 mb-1 flex items-center gap-1"><Clock size={12}/> Da Liquidare: {client.pendingCommissions.length} provvigioni</p>
                                    <p className="text-sm font-extrabold text-amber-700">Tot: € {formatCurrency(client.totalPendingCommissionAmount)}</p>
                                </div>
                            )}
                        </div>
                    </Card>
                ))}
            </div>
            {clients.length === 0 && (<div className="p-8 text-center mt-12"><Users size={64} className="mx-auto text-slate-300 mb-4"/><p className="text-slate-500">Nessun cliente trovato. Inserisci una nuova pratica per popolare questo archivio.</p></div>)}
        </div>
    );
};

const CommissionsView = ({ orders, getCompanyPaymentDate, handleUpdateCommissionPaid }) => {
    const [generatingReport, setGeneratingReport] = useState(false);

    const paidInstallments = orders.flatMap(order => (order.payments || []).filter(p => p.status === 'Pagato').map(p => ({ paymentId: p.id, paymentLabel: p.label, amount: p.amount, commissionPaid: p.commissionPaid, dueDate: p.dueDate, orderId: order.id, client: order.client, commissionRate: order.commissionRate, totalAmount: order.amount, })));
    const totalCommissionDue = paidInstallments.reduce((acc, p) => acc + calculateCommission(p.amount, p.totalAmount, p.commissionRate), 0);
    const pendingPaymentsSorted = paidInstallments.filter(p => !p.commissionPaid).sort((a, b) => new Date(a.dueDate) - new Date(b.dueDate));
    const totalPotentialCommissions = orders.reduce((acc, order) => { return acc + (order.amount * (order.commissionRate / 100)); }, 0);
    const residualCommissions = totalPotentialCommissions - totalCommissionDue;
    const nextPayout = getNextPayoutDate();
    const nextPayoutLabel = nextPayout.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
    const totalToLiquidate = pendingPaymentsSorted.reduce((acc, p) => acc + calculateCommission(p.amount, p.totalAmount, p.commissionRate), 0);
    
    const itemsWithCommissions = pendingPaymentsSorted.map(p => ({
        ...p,
        commissionAmount: calculateCommission(p.amount, p.totalAmount, p.commissionRate)
    }));

    const handleGenerateReport = async (mode) => {
        if (itemsWithCommissions.length === 0) return;
        setGeneratingReport(true);

        const reportData = {
            client: "Amministrazione / Backoffice",
            address: "Report Interno",
            totalPratiche: itemsWithCommissions.length,
            items: itemsWithCommissions,
            total: totalToLiquidate
        };

        const doc = await generatePDF(reportData, 'commission_report');
        
        if (doc) {
            const fileName = `Distinta_Provvigioni_${new Date().toISOString().split('T')[0]}.pdf`;
            
            if (mode === 'wa') {
                doc.save(fileName);
                
                const textLines = [
                    `*RICHIESTA LIQUIDAZIONE PROVVIGIONI* 📄`,
                    ``,
                    `Ciao, ti invio il riepilogo delle provvigioni maturate (clienti incassati) pronte per la liquidazione:`,
                    ``
                ];

                itemsWithCommissions.forEach(p => {
                     textLines.push(`👤 *${p.client}*`);
                     textLines.push(`▪️ ${p.paymentLabel} (€ ${formatCurrency(p.amount)})`);
                     textLines.push(`💰 *Provvigione: € ${formatCurrency(p.commissionAmount)}*`);
                     textLines.push(``);
                });

                textLines.push(`*TOTALE RICHIESTO: € ${formatCurrency(totalToLiquidate)}*`);
                textLines.push(``);
                textLines.push(`_Trovi la distinta formale in PDF allegata (appena scaricata sul mio PC)._`);

                const waText = encodeURIComponent(textLines.join('\n'));
                window.open(`https://api.whatsapp.com/send?text=${waText}`, '_blank');
            } else {
                doc.save(fileName);
            }
        }
        setGeneratingReport(false);
    };

    return (
        <div className="space-y-6 animate-fade-in">
            <h2 className="text-2xl font-bold text-slate-800 flex items-center gap-2"><Wallet className="text-[#0e5c2f]" /> Rendiconto Provvigioni</h2>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <Card className="p-5 border-l-4 border-l-blue-500">
                    <p className="text-sm text-slate-500 font-medium">Totale Provvigioni (Portafoglio)</p>
                    <h3 className="text-2xl font-bold text-slate-800">€ {formatCurrency(totalPotentialCommissions)}</h3>
                    <p className="text-[10px] text-slate-400 mt-1">Valore totale contratti inseriti</p>
                </Card>
                <Card className="p-5 border-l-4 border-l-emerald-500"><p className="text-sm text-slate-500 font-medium">Maturate (Incassate Clienti)</p><h3 className="text-2xl font-bold text-emerald-700">€ {formatCurrency(totalCommissionDue)}</h3></Card>
                <Card className="p-5 border-l-4 border-l-amber-500"><p className="text-sm text-slate-500 font-medium">In Attesa (Da Incassare)</p><h3 className="text-2xl font-bold text-amber-700">€ {formatCurrency(residualCommissions)}</h3></Card>
                <Card className="p-5 border-l-4 border-l-purple-500">
                    <p className="text-sm text-slate-500 font-medium">Prossima Liquidazione</p>
                    <h3 className="text-lg font-bold text-slate-800">15 {nextPayoutLabel}</h3>
                    <p className="text-xs text-purple-600 font-medium mt-1">({pendingPaymentsSorted.length} provvigioni da liquidare) - <span className="font-bold">€ {formatCurrency(totalToLiquidate)}</span></p>
                </Card>
            </div>

            {/* WIDGET DISTINTA DI PAGAMENTO */}
            {itemsWithCommissions.length > 0 && (
